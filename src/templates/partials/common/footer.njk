<footer class="footer">
    <div class="footer__wrapper">
        <div class="footer__content">

            <div class="footer__top">
                <div class="footer__brand">
                    <a class="footer__logo" href="/index.html">
                        <img
                            class="footer__logo-item"
                            src="/src/assets/images/pixmart-logo.svg"
                            alt="Footer logo"
                        >
                    </a>
                    <p class="footer__description">
                        Your premium digital assets solution with high quality and comprehensive range of products and services.
                    </p>
                </div>

                <div class="footer__links">
                    <div class="footer__column footer__column--company">
                        <p class="footer__title">Company</p>
                        <ul class="footer__list">
                            <li class="footer__item"><a href="#" class="footer__link link">Homepage v1</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Homepage v2</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Homepage v3</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">About Us</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">About Us</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Blog Articles</a></li>
                        </ul>
                    </div>

                    <div class="footer__column footer__column--products">
                        <p class="footer__title">Products</p>
                        <ul class="footer__list">
                            <li class="footer__item"><a href="#" class="footer__link link">Website</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Mobile App</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Social Media Feeds</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Presentation</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Product Mockups</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Illustrations</a></li>
                        </ul>
                    </div>

                    <div class="footer__column footer__column--account">
                        <p class="footer__title">Account</p>
                        <ul class="footer__list">
                            <li class="footer__item"><a href="#" class="footer__link link">Your Cart</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Check Out</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Refund Policy</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Company Policy</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Send A Message</a></li>
                            <li class="footer__item"><a href="#" class="footer__link link">Customer Support</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="footer__newsletter">
                <div class="footer__social">
                    {% from 'src/templates/partials/ui/icon.njk' import icon %} 
                    <a  href="https://x.com/" class="button button--secondary button--icon-lg" aria-label="Twitter" target="_blank">  
                        {{ icon("icon-twitter") }} 
                    </a>
                    <a href="https://www.facebook.com/" class="button button--secondary button--icon-lg" aria-label="Facebook" target="_blank">
                        {{ icon("icon-facebook") }} 
                    </a>

                    <a href="https://web.telegram.org/" class="button button--secondary button--icon-lg" aria-label="Telegram" target="_blank">
                        {{ icon("icon-telegram") }} 
                    </a>
                </div>

                <form class="footer__form">
                    <p class="footer__form-title">
                        <span class="footer__form-line">Subscribe to</span>
                        <span class="footer__form-line">Design Newsletter</span>
                    </p>
                    <div class="footer__form-group">
                        <label for="footer-email" class="visually-hidden">Your email address</label>
                        <input
                            id="footer-email"
                            type="email"
                            class="footer__form-input form-field"
                            placeholder="Enter your email address ..."
                        >
                        <button type="submit" class="button button--primary button--lg">Subscribe</button>
                    </div>
                </form>
            </div>

        </div>
    </div>

    <div class="footer__wrapper footer__wrapper--bottom">
        <div class="footer__content">
            <div class="footer__bottom-container">
                <div class="footer__legal">
                    <a href="#" class="footer__legal-link link">Privacy Policy</a>
                    <a href="#" class="footer__legal-link link">Terms and Condition</a>
                    <a href="#" class="footer__legal-link link">Site Map</a>
                </div>
                <p class="footer__copyright">Copyright © 2024 Pixmart. All rights reserved.</p>
            </div>
        </div>
    </div>

</footer>
