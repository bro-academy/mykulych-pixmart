<div class="trending">

    <div class="trending__header">
        <div class="trending__heading">
            <span class="trending__tag">{{ g_trending }}</span>
            <h2 class="trending__title heading-h2">{{ g_popular_products }}</h2>
        </div>    
        
        <div class="trending__buttons">
            <button class="button button--secondary button--icon-lg">
                {% from 'src/templates/partials/ui/icon.njk' import icon %}
                {{ icon("icon-chevron-left") }}
            </button>
            <button class="button button--secondary button--icon-lg">
                {{ icon("icon-chevron-right") }}
            </button>
        </div>

    </div>

    <div class="product-slider">
        {% for item in items %}

        <div class="card">
            <div class="card__illustration">
                {% from 'src/templates/partials/ui/icon.njk' import picture %}
                {{ picture("card__illustration-img", item.image, item.alt) }}
                {% if item.badge %}
                <div class="card__badge">
                    <img src="{{ item.badge }}" alt="Badge label">
                </div>
                {% endif %}
            </div>
            <div class="card__content">
                <div class="card__text">
                    <h3 class="card__text-title">{{ item.title }}</h3>
                    <p class="card__text-meta">{{ item.meta }}</p>
                </div>
                <p class="card__price">{{ item.price }}</p>
            </div>
            <div class="card__hover-button">
                <a class="card__hover-button button button--primary button--lg" href="#">{{ g_go }}</a>
            </div>
        </div>

        {% endfor %}
    </div>


</div>